# Apache SPA fallback (cPanel, shared hosting, Plesk-Apache)
# Sends every unknown URL to index.html so React Router can handle it.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow real files and directories to be served normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed assets, never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
